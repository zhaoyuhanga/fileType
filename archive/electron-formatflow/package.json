{
  "name": "filetype",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Offline desktop format converter for Windows and macOS",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron --import tsx ./src/main/main.ts\"",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && tsc -p tsconfig.node.json && node -e \"require('fs').copyFileSync('src/main/preload.cjs','dist/main/preload.cjs')\" && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack:win": "npm run build && electron-builder --win nsis",
    "pack:mac": "npm run build && electron-builder --mac dmg"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "bmp-js": "^0.1.0",
    "docx": "^9.6.1",
    "dompurify": "^3.4.14",
    "ffmpeg-static": "^5.3.0",
    "iconv-lite": "^0.7.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.541.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.4",
    "node-unrar-js": "^2.0.2",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.5",
    "tar-stream": "^3.2.0",
    "turndown": "^7.2.4",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.15.29",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/tar-stream": "^3.1.4",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.2.0",
    "electron": "^35.5.1",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3"
  }
}
