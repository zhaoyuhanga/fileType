{
  "api": "8",
  "type": "anime",
  "name": "示例_API站",
  "version": "1.0",
  "baseURL": "https://api.example.com/",
  "searchMode": "api",
  "chapterMode": "api",
  "searchApiConfig": {
    "request": {
      "method": "GET",
      "url": "https://api.example.com/api/videos/search",
      "headers": {},
      "query": {
        "q": "@keyword",
        "pageSize": 20
      },
      "body": null
    },
    "listPath": "$.data.videos[*]",
    "namePath": "$.name",
    "sourcePath": "$.id"
  },
  "chapterApiConfig": {
    "request": {
      "method": "GET",
      "url": "https://api.example.com/api/videos/@source"
    },
    "format": "nested",
    "roadsPath": "$.data.playSources[*]",
    "roadNamePath": "$.name",
    "episodesPath": "$.episodes[*]",
    "episodeNamePath": "$.name",
    "episodeUrlPath": "",
    "variables": {
      "slug": "$.data.slug"
    },
    "episodePage": {
      "url": "https://api.example.com/video/@slug/play",
      "query": {
        "source": "@roadIndex",
        "episode": "@episodeIndex"
      }
    }
  },
  "notes": "演示 API 模式规则的字段结构（搜索 listPath/namePath/sourcePath → 详情 roadsPath/episodesPath → 播放页模板 @slug/@roadIndex/@episodeIndex），站点是占位域名，不会真的请求成功。请照这个结构换成自己有权限的接口；JSONPath 只支持 $ / .a.b / [*] / [0] / ['k']，不支持递归、过滤、切片与函数。"
}
